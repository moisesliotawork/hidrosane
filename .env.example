APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ohanaplus
DB_USERNAME=root
DB_PASSWORD=

# Copia del dump para recuperar contratos perdidos (ventas:recover-from-backup)
# DB_BACKUP_HOST=127.0.0.1
# DB_BACKUP_PORT=3306
# DB_BACKUP_DATABASE=ohana_backup
# DB_BACKUP_USERNAME=root
# DB_BACKUP_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="notas@support.appohana.com"
MAIL_FROM_NAME="Ohana Plus"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

RESEND_API_KEY=

# SuperAdmin: recuperación de contratos desde imagen (no afecta flujos comerciales)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1


############################################
# ─── MARCA ───────────────────────────────
############################################
# Sin estas variables la app se ve como Ohana. Cada instalación pone las suyas.
BRAND_NAME="Hidrosane"
BRAND_LOGO=images/logo.png
# Nombre de paleta de Filament (Lime, Sky, Blue, Emerald…) o hex (#0284c7)
BRAND_COLOR=Sky

############################################
# ─── DEMO ────────────────────────────────
############################################
# Botones de acceso sin credenciales en el login. APAGAR antes de datos reales.
DEMO_LOGIN=false

############################################
# ─── NOTIFICACIONES INTERNAS ─────────────
############################################
# Sin valor no se envía el PDF de notas a oficina. No poner el buzón de otra empresa.
NOTIFICACIONES_OFICINA_EMAIL=

############################################
# ─── DIGITALOCEAN SPACES (documentos) ────
############################################
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=fra1
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com

# Disco de documentos: 'public' (local, por defecto) o 'spaces'
DOCUMENTS_DISK=public
DOCUMENTS_FALLBACK_DISK=public
DOCUMENTS_URL_TTL=15

############################################
# ─── TELEGRAM (vacío = no se envía nada) ─
############################################
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_VENTAS=
TELEGRAM_CHAT_ID_CANTICOS=
TELEGRAM_CHAT_ID_ACCION_OHANA=

############################################
# ─── ENTRADA DESDE OHANA (SSO) ───────────
############################################
# Mismo valor en el .env de Ohana. Vacío = la ruta /sso/entrar no existe.
# Generar con: php -r "echo bin2hex(random_bytes(32));"
SSO_SECRET=
SSO_TTL=60

# A dónde vuelve el botón de Ohana.
OHANA_URL=https://appohana.com
